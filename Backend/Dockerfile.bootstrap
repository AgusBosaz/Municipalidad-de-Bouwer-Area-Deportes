# Compilar y publicar la herramienta.
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build

WORKDIR /src

COPY . .

RUN dotnet restore Muni-Bouwer.Bootstrap/Muni-Bouwer.Bootstrap.csproj

RUN dotnet publish Muni-Bouwer.Bootstrap/Muni-Bouwer.Bootstrap.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

# Ejecutar la herramienta publicada.
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

WORKDIR /app

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "Muni-Bouwer.Bootstrap.dll"]